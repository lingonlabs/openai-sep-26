{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": [
      "node",
      "chrome"
    ]
  },
  "include": [
    "src",
    "scripts/build.ts",
    "scripts/smoke-live.ts",
    "eval",
    "tests/*.test.ts",
    "tests/browser",
    "playwright.config.ts"
  ]
}
