{
  "name": "close-copilot",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "pnpm --filter @close/workbench build && pnpm --filter @close/extension build",
    "dev": "pnpm run build && pnpm --filter @close/server start",
    "start": "pnpm --filter @close/server start",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:browser": "playwright test",
    "eval:gate": "tsx eval/gate.ts",
    "check": "pnpm typecheck && pnpm test && pnpm check:ambient",
    "smoke:live": "tsx scripts/smoke-live.ts",
    "journal:dev": "pnpm journal:build && tsx src/relay/main.ts",
    "journal:build": "tsx scripts/build.ts",
    "journal:start": "tsx src/relay/main.ts",
    "typecheck:ambient": "tsc -p tsconfig.ambient.json --noEmit && pnpm --filter @close/extension typecheck",
    "test:ambient": "tsx --test packages/shared/tests/*.test.ts packages/ui/tests/*.test.ts apps/server/tests/*.test.ts",
    "test:ambient-browser": "playwright test -c playwright.ambient.config.ts",
    "check:ambient": "pnpm run typecheck:ambient && pnpm run test:ambient && pnpm run build",
    "demo:record": "playwright test -c playwright.ambient.config.ts demo.spec.ts",
    "open": "tsx scripts/open-workbench.ts"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "openai": "^7.13.0",
    "zod": "^4.6.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/chrome": "^0.2.9",
    "@types/node": "^22.20.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "esbuild": "^0.28.2",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^7.3.6"
  },
  "packageManager": "pnpm@11.19.0"
}
