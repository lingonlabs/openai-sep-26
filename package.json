{
  "name": "ambient-close", "private": true, "type": "module",
  "packageManager": "pnpm@10.30.2",
  "engines": { "node": ">=22.13.0", "pnpm": ">=10.30.2 <11" },
  "scripts": {
    "dev": "node --import tsx --env-file-if-exists=.env apps/server/src/index.ts",
    "dev:extension": "pnpm --filter @ambient/extension dev",
    "build": "pnpm --filter @ambient/extension build",
    "typecheck": "pnpm -r typecheck",
    "test": "node --import tsx --test tests/*.test.ts apps/extension/tests/*.test.ts",
    "smoke": "node --import tsx --env-file-if-exists=.env apps/server/src/smoke.ts",
    "check:ages": "node scripts/check-release-ages.mjs"
  },
  "devDependencies": { "typescript": "^5.9.0", "tsx": "^4.20.0", "@types/node": "^22.0.0", "yaml": "^2.8.0" }
}
