# Copy to .env locally. Never commit credentials.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra
# demo = deterministic synthetic-data checks; live = real Astra, no fallback.
GATE_MODE=demo
PORT=4317
GATE_TIMEOUT_MS=8000
# Exact HTTPS sandbox origin. Its adapter remains disabled until verified.
NETSUITE_ORIGIN=
# Optional exact chrome-extension://... origin to restrict paired extensions.
EXTENSION_ORIGIN=

# Ambient Close Copilot (new workspace application)
APP_PORT=4318
# live uses Astra; demo is deterministic and only works with synthetic demo pages.
AGENT_MODE=live
ASTRA_MODEL=gpt-6-astra
NETSUITE_SANDBOX_ORIGIN=https://11816061-sb1.app.netsuite.com
# Optional SQLite location (defaults to ignored .local/close-copilot.sqlite)
# APP_DB_PATH=
